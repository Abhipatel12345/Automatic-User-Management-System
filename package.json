{
  "name": "user-management-system",
  "version": "1.0.0",
  "description": "Customer & Payment Management ERP/CRM System",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "prisma generate --schema=server/prisma/schema.prisma && npm --prefix server run build && npm --prefix client run build && node -e \"const fs=require('fs'); fs.cpSync('dist', 'public', {recursive: true});\"",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run prisma:seed"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.19.1"
  }
}
