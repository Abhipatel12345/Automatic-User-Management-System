{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
